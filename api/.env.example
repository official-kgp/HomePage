# Cloudflare Worker local development secrets.
# Copy this file to .dev.vars (never commit the copied file).
ADMIN_API_KEY=replace-me
PUBLIC_DISCORD_CLIENT_SECRET=replace-me
SESSION_SECRET=replace-with-a-long-random-value
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public sender/recipient settings are configured in wrangler.toml [vars].
# RESEND_FROM_EMAIL=KGP <contact@kgp.suiten.site>
# CONTACT_TO_EMAIL=contact@kgp.suiten.site
